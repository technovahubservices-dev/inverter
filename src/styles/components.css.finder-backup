/* =========================================
   NAVBAR
========================================= */

.navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  padding: 18px 24px;
}

.navbar-inner {
  width: min(1380px, 100%);
  margin: auto;
  height: 68px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 18px;

  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 18px;

  background: rgba(5, 8, 11, 0.58);

  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);

  box-shadow:
    0 15px 50px rgba(0, 0, 0, 0.25),
    inset 0 1px rgba(255, 255, 255, 0.05);
}

.brand {
  display: flex;
  align-items: center;
  gap: 11px;
}

.brand-name {
  font-family: "Manrope", sans-serif;
  font-size: 14px;
  font-weight: 800;
  letter-spacing: 0.16em;
}

.brand-mark {
  width: 27px;
  height: 27px;

  position: relative;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 2px;
}

.brand-mark span {
  display: block;

  width: 5px;

  border-radius: 999px;

  background: linear-gradient(
    to bottom,
    var(--color-blue),
    var(--color-green)
  );
}

.brand-mark span:first-child {
  height: 17px;
}

.brand-mark span:last-child {
  height: 23px;
}

.desktop-nav {
  display: flex;
  align-items: center;
  gap: 32px;
}

.nav-link {
  position: relative;

  color: rgba(255, 255, 255, 0.7);

  font-size: 12px;
  font-weight: 500;

  transition: color 250ms ease;
}

.nav-link::after {
  content: "";

  position: absolute;

  left: 0;
  bottom: -7px;

  width: 0;
  height: 1px;

  background: var(--color-blue);

  transition: width 300ms ease;
}

.nav-link:hover {
  color: white;
}

.nav-link:hover::after {
  width: 100%;
}

.navbar-actions {
  display: flex;
  align-items: center;
  gap: 9px;
}

.nav-icon {
  position: relative;

  width: 38px;
  height: 38px;

  display: grid;
  place-items: center;

  color: rgba(255, 255, 255, 0.8);

  background: rgba(255, 255, 255, 0.04);

  border: 1px solid rgba(255, 255, 255, 0.08);

  border-radius: 11px;

  transition:
    background 250ms ease,
    color 250ms ease,
    transform 250ms ease;
}

.nav-icon:hover {
  color: white;
  background: rgba(255, 255, 255, 0.09);
  transform: translateY(-1px);
}

.cart-count {
  position: absolute;

  top: -4px;
  right: -4px;

  min-width: 15px;
  height: 15px;

  display: grid;
  place-items: center;

  padding: 0 3px;

  border-radius: 999px;

  background: var(--color-green);

  color: #031008;

  font-size: 8px;
  font-weight: 800;
}

.quote-button {
  height: 38px;

  display: flex;
  align-items: center;
  gap: 8px;

  padding: 0 15px;

  border-radius: 11px;

  background: white;
  color: #05070a;

  font-size: 11px;
  font-weight: 700;

  transition:
    transform 250ms ease,
    box-shadow 250ms ease;
}

.quote-button:hover {
  transform: translateY(-2px);

  box-shadow:
    0 8px 25px rgba(255, 255, 255, 0.16);
}

.mobile-menu-button {
  display: none;
}

/* =========================================
   HERO
========================================= */

.hero {
  position: relative;

  width: 100%;
  height: 100svh;
  min-height: 700px;

  overflow: hidden;

  background: var(--color-black);
}

.hero-video {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.hero-video video {
  width: 100%;
  height: 100%;

  object-fit: cover;

  filter: saturate(0.85) contrast(1.05);
}

.hero-overlay {
  position: absolute;
  inset: 0;
  z-index: 1;

  background:
    linear-gradient(
      90deg,
      rgba(3, 7, 10, 0.92) 0%,
      rgba(3, 7, 10, 0.66) 38%,
      rgba(3, 7, 10, 0.25) 75%,
      rgba(3, 7, 10, 0.48) 100%
    ),
    linear-gradient(
      0deg,
      rgba(3, 7, 10, 0.9) 0%,
      transparent 35%,
      rgba(3, 7, 10, 0.25) 100%
    );
}

.hero-grid {
  position: absolute;
  inset: 0;
  z-index: 2;

  opacity: 0.13;

  background-image:
    linear-gradient(
      rgba(255, 255, 255, 0.08) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.08) 1px,
      transparent 1px
    );

  background-size: 80px 80px;

  mask-image: linear-gradient(
    to bottom,
    black,
    transparent 80%
  );
}

.hero-glow {
  position: absolute;

  width: 600px;
  height: 600px;

  border-radius: 50%;

  filter: blur(100px);

  pointer-events: none;

  z-index: 2;
}

.hero-glow-one {
  left: -200px;
  top: 20%;

  background: rgba(77, 163, 255, 0.16);
}

.hero-glow-two {
  right: -200px;
  bottom: -200px;

  background: rgba(54, 217, 138, 0.1);
}

.hero-content {
  position: relative;
  z-index: 5;

  height: 100%;

  display: flex;
  flex-direction: column;
  justify-content: center;

  padding-top: 80px;
}

.hero-eyebrow {
  display: flex;
  align-items: center;
  gap: 9px;

  margin-bottom: 25px;

  color: rgba(255, 255, 255, 0.65);

  font-size: 10px;
  font-weight: 600;

  letter-spacing: 0.22em;
}

.live-dot {
  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: var(--color-green);

  box-shadow:
    0 0 0 4px rgba(54, 217, 138, 0.08),
    0 0 20px rgba(54, 217, 138, 0.7);

  animation: pulseGlow 2s infinite;
}

.hero h1 {
  max-width: 850px;

  font-family: "Manrope", sans-serif;

  font-size: clamp(64px, 9vw, 138px);

  line-height: 0.88;

  font-weight: 800;

  letter-spacing: -0.075em;

  color: white;
}

.hero h1 span {
  display: block;

  background: linear-gradient(
    100deg,
    white 20%,
    rgba(255, 255, 255, 0.45)
  );

  -webkit-background-clip: text;
  background-clip: text;

  -webkit-text-fill-color: transparent;
}

.hero-description {
  max-width: 470px;

  margin-top: 30px;

  color: rgba(255, 255, 255, 0.62);

  font-size: 15px;

  line-height: 1.7;
}

.hero-actions {
  display: flex;
  align-items: center;

  gap: 18px;

  margin-top: 35px;
}

.hero-primary-button {
  display: flex;
  align-items: center;
  gap: 12px;

  padding: 14px 19px;

  border-radius: 12px;

  background: white;
  color: #05070a;

  font-size: 12px;
  font-weight: 700;

  transition:
    transform 250ms ease,
    box-shadow 250ms ease;
}

.hero-primary-button:hover {
  transform: translateY(-3px);

  box-shadow:
    0 15px 40px rgba(255, 255, 255, 0.18);
}

.hero-video-button {
  display: flex;
  align-items: center;
  gap: 10px;

  color: rgba(255, 255, 255, 0.85);

  background: transparent;

  font-size: 12px;
  font-weight: 600;
}

.play-icon {
  width: 34px;
  height: 34px;

  display: grid;
  place-items: center;

  border: 1px solid rgba(255, 255, 255, 0.25);

  border-radius: 50%;

  transition:
    background 250ms ease,
    transform 250ms ease;
}

.hero-video-button:hover .play-icon {
  background: rgba(255, 255, 255, 0.1);
  transform: scale(1.08);
}

.hero-bottom {
  position: absolute;

  z-index: 5;

  left: 0;
  right: 0;
  bottom: 25px;

  width: min(
    calc(100% - (var(--container-padding) * 2)),
    var(--container-width)
  );

  margin: auto;

  display: grid;
  grid-template-columns: 1fr auto 1fr;

  align-items: end;
}

.hero-status {
  display: flex;
  align-items: center;
  gap: 8px;

  color: rgba(255, 255, 255, 0.45);

  font-size: 9px;
  letter-spacing: 0.14em;
}

.hero-status svg {
  color: var(--color-green);
}

.hero-status strong {
  color: var(--color-green);

  font-weight: 600;
}

.hero-scroll {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 9px;

  color: rgba(255, 255, 255, 0.4);

  font-size: 8px;
  letter-spacing: 0.2em;
}

.hero-index {
  justify-self: end;

  display: flex;
  gap: 7px;

  color: rgba(255, 255, 255, 0.3);

  font-size: 9px;
}

.hero-index span:first-child {
  color: white;
}

/* =========================================
   MOBILE MENU
========================================= */

.mobile-menu {
  position: fixed;
  inset: 0;

  z-index: 2000;

  padding: 22px;

  background: #05070a;

  display: flex;
  flex-direction: column;
}

.mobile-menu-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mobile-nav {
  margin-top: 80px;

  display: flex;
  flex-direction: column;
}

.mobile-nav a {
  display: grid;
  grid-template-columns: 35px 1fr auto;
  align-items: center;

  padding: 22px 0;

  border-bottom: 1px solid rgba(255, 255, 255, 0.09);

  font-family: "Manrope", sans-serif;

  font-size: 30px;
  font-weight: 600;
}

.mobile-nav a span {
  color: var(--color-blue);

  font-family: var(--font-main);

  font-size: 10px;
}

.mobile-contact {
  margin-top: auto;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 17px 20px;

  border-radius: 14px;

  background: white;

  color: black;

  font-size: 12px;
  font-weight: 700;
}
.inverter-showcase {
  position: relative;
  min-height: 100vh;
  padding: 150px 0 90px;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 45%, rgba(77, 163, 255, 0.08), transparent 30%),
    #080d12;
}

.inverter-heading {
  position: relative;
  z-index: 2;
  max-width: 720px;
}

.section-label {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 25px;
  color: var(--color-text-muted);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.18em;
}

.section-label span {
  color: var(--color-blue);
}

.inverter-heading h2 {
  font-family: var(--font-main);
  font-size: clamp(48px, 7vw, 100px);
  line-height: 0.95;
  letter-spacing: -0.055em;
  font-weight: 700;
}

.inverter-heading h2 span {
  display: block;
  color: var(--color-text-muted);
}

.inverter-heading p {
  max-width: 520px;
  margin-top: 28px;
  color: var(--color-text-secondary);
  font-size: 15px;
  line-height: 1.8;
}

.inverter-stage {
  position: relative;
  min-height: 650px;
  margin-top: 50px;
  display: grid;
  place-items: center;
}

.inverter-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  pointer-events: none;
}

.inverter-orb-one {
  width: 300px;
  height: 300px;
  top: 20%;
  left: 20%;
  background: rgba(77, 163, 255, 0.08);
}

.inverter-orb-two {
  width: 250px;
  height: 250px;
  right: 15%;
  bottom: 15%;
  background: rgba(54, 217, 138, 0.05);
}

.energy-ring {
  position: absolute;
  border: 1px solid rgba(77, 163, 255, 0.13);
  border-radius: 50%;
}

.energy-ring-one {
  width: 500px;
  height: 500px;
}

.energy-ring-two {
  width: 700px;
  height: 700px;
  border-color: rgba(255, 255, 255, 0.045);
}

.energy-pulse {
  position: absolute;
  width: 760px;
  height: 760px;
  border-radius: 50%;
  border: 1px dashed rgba(77, 163, 255, 0.1);
}

.inverter-product {
  position: relative;
  z-index: 3;
}

.inverter-device {
  width: 280px;
  height: 470px;
  padding: 24px 22px;
  border-radius: 24px;
  border: 1px solid rgba(255, 255, 255, 0.14);
  background:
    linear-gradient(145deg, #1a232d, #090d12 65%);
  box-shadow:
    0 50px 100px rgba(0, 0, 0, 0.55),
    inset 0 1px 0 rgba(255, 255, 255, 0.08);
  transform: perspective(1000px) rotateY(-8deg);
}

.device-top,
.device-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.device-brand {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.14em;
}

.device-status {
  display: flex;
  align-items: center;
  gap: 6px;
  color: var(--color-green);
  font-size: 7px;
  font-weight: 700;
  letter-spacing: 0.12em;
}

.device-status i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--color-green);
  box-shadow: 0 0 12px var(--color-green);
}

.device-display {
  margin-top: 70px;
  padding: 28px 20px;
  border-radius: 14px;
  background: #05080b;
  border: 1px solid rgba(255, 255, 255, 0.07);
}

.display-label {
  display: block;
  color: var(--color-text-muted);
  font-size: 8px;
  letter-spacing: 0.16em;
}

.device-display strong {
  display: inline-block;
  margin-top: 8px;
  font-family: var(--font-main);
  font-size: 52px;
  line-height: 1;
  letter-spacing: -0.06em;
}

.device-display small {
  margin-left: 6px;
  color: var(--color-blue-bright);
  font-size: 14px;
}

.device-bars {
  display: flex;
  align-items: end;
  gap: 6px;
  height: 90px;
  margin-top: 35px;
}

.device-bars span {
  flex: 1;
  border-radius: 3px;
  background: linear-gradient(
    to top,
    rgba(77, 163, 255, 0.2),
    rgba(77, 163, 255, 0.8)
  );
}

.device-bars span:nth-child(1) {
  height: 30%;
}

.device-bars span:nth-child(2) {
  height: 48%;
}

.device-bars span:nth-child(3) {
  height: 42%;
}

.device-bars span:nth-child(4) {
  height: 68%;
}

.device-bars span:nth-child(5) {
  height: 58%;
}

.device-bars span:nth-child(6) {
  height: 82%;
}

.device-bottom {
  margin-top: 55px;
  color: var(--color-text-muted);
  font-size: 7px;
  letter-spacing: 0.12em;
}

.device-bottom svg {
  color: var(--color-blue);
}

.device-shadow {
  position: absolute;
  z-index: -1;
  left: 50%;
  bottom: -30px;
  width: 260px;
  height: 50px;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.65);
  filter: blur(25px);
}

.inverter-callout {
  position: absolute;
  z-index: 4;
  display: flex;
  align-items: center;
  gap: 18px;
}

.callout-left {
  left: 8%;
  top: 38%;
}

.callout-right {
  right: 8%;
  top: 52%;
  text-align: right;
}

.callout-line {
  width: 70px;
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(77, 163, 255, 0.7)
  );
}

.callout-right .callout-line {
  transform: rotate(180deg);
}

.inverter-callout small {
  display: block;
  margin-bottom: 7px;
  color: var(--color-blue);
  font-size: 9px;
}

.inverter-callout strong {
  display: block;
  font-size: 10px;
  letter-spacing: 0.1em;
}

.inverter-callout p {
  margin-top: 5px;
  color: var(--color-text-muted);
  font-size: 11px;
}

.inverter-bottom {
  position: relative;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  border-top: 1px solid var(--border-subtle);
  padding-top: 35px;
}

.inverter-specs {
  display: flex;
  gap: 55px;
}

.inverter-spec {
  display: flex;
  align-items: center;
  gap: 13px;
}

.inverter-spec > svg {
  color: var(--color-blue);
}

.inverter-spec strong {
  display: block;
  font-size: 19px;
  letter-spacing: -0.03em;
}

.inverter-spec strong small {
  margin-left: 3px;
  color: var(--color-text-muted);
  font-size: 10px;
}

.inverter-spec span {
  display: block;
  margin-top: 4px;
  color: var(--color-text-muted);
  font-size: 9px;
  letter-spacing: 0.05em;
}

.inverter-explore {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px 18px;
  border: 1px solid var(--border-light);
  border-radius: 999px;
  font-size: 11px;
  transition: var(--transition-normal);
}

.inverter-explore:hover {
  border-color: rgba(77, 163, 255, 0.5);
  background: rgba(77, 163, 255, 0.07);
  transform: translateY(-2px);
}
.power-flow {
  position: relative;
  min-height: 100vh;
  padding: 150px 0 100px;
  overflow: hidden;
  background: #05080b;
}

.power-flow-bg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(
      circle at 50% 55%,
      rgba(77, 163, 255, 0.08),
      transparent 30%
    ),
    linear-gradient(
      180deg,
      #080d12 0%,
      #05080b 100%
    );
  pointer-events: none;
}

.power-flow-header,
.power-flow-control,
.power-system,
.power-flow-info,
.power-flow-bottom {
  position: relative;
  z-index: 2;
}

.power-flow-title-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 60px;
}

.power-flow-title-row h2 {
  max-width: 700px;
  font-size: clamp(48px, 7vw, 96px);
  line-height: 0.95;
  letter-spacing: -0.055em;
}

.power-flow-title-row h2 span {
  display: block;
  color: var(--color-text-muted);
}

.power-flow-title-row p {
  max-width: 390px;
  padding-bottom: 8px;
  color: var(--color-text-secondary);
  font-size: 14px;
  line-height: 1.8;
}

.power-flow-control {
  display: flex;
  width: fit-content;
  margin: 70px auto 55px;
  padding: 5px;
  border: 1px solid var(--border-subtle);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.025);
}

.power-flow-control button {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 10px 17px;
  border-radius: 999px;
  background: transparent;
  color: var(--color-text-muted);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  transition: var(--transition-normal);
}

.power-flow-control button.active {
  background: rgba(77, 163, 255, 0.12);
  color: var(--color-white);
}

.power-flow-control button.active.outage {
  background: rgba(255, 181, 71, 0.1);
}

.control-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: currentColor;
}

.power-flow-control button.active .control-dot {
  box-shadow: 0 0 10px currentColor;
}

.power-system {
  display: grid;
  grid-template-columns: 1fr 120px 1.2fr 120px 1fr;
  align-items: center;
  gap: 0;
  min-height: 300px;
}

.power-node {
  position: relative;
  min-height: 220px;
  padding: 35px 25px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border: 1px solid var(--border-subtle);
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.025);
  text-align: center;
}

.grid-node {
  background:
    radial-gradient(
      circle at 50% 40%,
      rgba(77, 163, 255, 0.07),
      transparent 60%
    ),
    rgba(255, 255, 255, 0.025);
}

.inverter-node {
  min-height: 260px;
  border-color: rgba(77, 163, 255, 0.25);
  background:
    radial-gradient(
      circle at 50% 45%,
      rgba(77, 163, 255, 0.12),
      transparent 65%
    ),
    rgba(10, 17, 24, 0.9);
  box-shadow:
    0 25px 80px rgba(0, 0, 0, 0.35),
    inset 0 0 60px rgba(77, 163, 255, 0.03);
}

.inverter-node-glow {
  position: absolute;
  inset: 15%;
  border-radius: 50%;
  background: rgba(77, 163, 255, 0.12);
  filter: blur(50px);
  pointer-events: none;
}

.home-node {
  background:
    radial-gradient(
      circle at 50% 40%,
      rgba(54, 217, 138, 0.06),
      transparent 60%
    ),
    rgba(255, 255, 255, 0.025);
}

.node-icon {
  position: relative;
  z-index: 1;
  display: grid;
  width: 58px;
  height: 58px;
  margin-bottom: 20px;
  place-items: center;
  border: 1px solid var(--border-light);
  border-radius: 16px;
  color: var(--color-blue);
  background: rgba(255, 255, 255, 0.035);
}

.home-node .node-icon {
  color: var(--color-green);
}

.node-kicker {
  color: var(--color-text-muted);
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.18em;
}

.power-node strong {
