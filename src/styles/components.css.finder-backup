}

.appliance-option.selected {
  border-color: rgba(77, 163, 255, 0.6);
  background: rgba(77, 163, 255, 0.1);
  color: white;
}

.appliance-check {
  display: grid;
  flex: 0 0 auto;
  width: 19px;
  height: 19px;
  place-items: center;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 50%;
  color: #66b5ff;
}

.appliance-option.selected .appliance-check {
  border-color: #66b5ff;
  background: rgba(77, 163, 255, 0.15);
}

.selector-divider {
  height: 1px;
  margin: 38px 0;
  background: rgba(255, 255, 255, 0.08);
}

.home-size-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 9px;
  margin-top: 27px;
}

.home-size-option {
  position: relative;
  min-height: 105px;
  padding: 18px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.025);
  color: #aab4bd;
  text-align: left;
  transition:
    border-color 220ms ease,
    background 220ms ease,
    transform 220ms ease;
}

.home-size-option:hover {
  border-color: rgba(77, 163, 255, 0.35);
  transform: translateY(-2px);
}

.home-size-option.selected {
  border-color: rgba(77, 163, 255, 0.6);
  background: rgba(77, 163, 255, 0.1);
}

.home-size-option strong {
  display: block;
  margin-bottom: 7px;
  color: #f4f7fa;
  font-size: 14px;
}

.home-size-option span {
  display: block;
  color: #717e89;
  font-size: 11px;
  line-height: 1.5;
}

.home-size-check {
  position: absolute;
  top: 15px;
  right: 15px;
  color: #66b5ff;
}

.find-inverter-result {
  min-height: 100%;
}

.find-inverter-empty {
  display: flex;
  height: 100%;
  min-height: 560px;
  flex-direction: column;
  justify-content: center;
  padding: 42px;
}

.find-inverter-empty > span {
  margin-bottom: 25px;
  color: #66b5ff;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.12em;
}

.find-inverter-empty strong {
  max-width: 300px;
  color: #f4f7fa;
  font-size: 28px;
  line-height: 1.1;
  letter-spacing: -0.035em;
}

.find-inverter-empty p {
  max-width: 320px;
  margin-top: 15px;
  color: #75818b;
  font-size: 13px;
  line-height: 1.7;
}

.find-inverter-recommendation {
  display: flex;
  min-height: 560px;
  height: 100%;
  flex-direction: column;
  padding: 34px;
}

.recommendation-label {
  display: flex;
  gap: 10px;
  color: #7b8892;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.14em;
}

.recommendation-label span {
  color: #66b5ff;
}

.recommendation-image {
  display: grid;
  flex: 1;
  min-height: 220px;
  place-items: center;
}

.recommendation-image img {
  width: 75%;
  max-width: 280px;
  filter: drop-shadow(0 25px 30px rgba(0, 0, 0, 0.35));
}

.recommendation-category {
  color: #697680;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.find-inverter-recommendation h3 {
  margin-top: 8px;
  color: #f4f7fa;
  font-size: 31px;
  letter-spacing: -0.045em;
}

.find-inverter-recommendation > p {
  margin-top: 6px;
  color: #8b969f;
  font-size: 13px;
}

.recommendation-button {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 23px;
  padding: 14px 16px;
  border-radius: 999px;
  background: #f4f7fa;
  color: #080d12;
  font-size: 11px;
  font-weight: 700;
  transition:
    transform 220ms ease,
    background 220ms ease;
}

.recommendation-button:hover {
  background: #66b5ff;
  transform: translateY(-2px);
}

.recommendation-reset {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  margin-top: 15px;
  background: transparent;
  color: #66737e;
  font-size: 10px;
}

.recommendation-reset:hover {
  color: #f4f7fa;
}

@media (max-width: 1000px) {
  .find-inverter-layout {
    grid-template-columns: 1fr;
  }

  .find-inverter-result {
    min-height: 500px;
  }

  .find-inverter-empty,
  .find-inverter-recommendation {
    min-height: 500px;
  }
}

@media (max-width: 650px) {
  .find-inverter {
    padding: 80px 0;
  }

  .find-inverter-heading {
    margin-bottom: 38px;
  }

  .find-inverter-heading h2 {
    font-size: 43px;
  }

  .find-inverter-panel {
    padding: 24px;
    border-radius: 21px;
  }

  .appliance-grid,
  .home-size-grid {
    grid-template-columns: 1fr 1fr;
  }

  .selector-step-heading h3 {
    font-size: 17px;
  }

  .find-inverter-empty,
  .find-inverter-recommendation {
    min-height: 430px;
    padding: 27px;
  }

  .recommendation-image {
    min-height: 170px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .appliance-option,
  .home-size-option,
  .recommendation-button {
    transition: none;
  }
}

